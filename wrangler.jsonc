{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kayanest",
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2025-12-13",
  "compatibility_flags": [
    "nodejs_compat_v2"
  ],
  "routes": [
    {
      "pattern": "kayanest.app",
      "custom_domain": true
    },
    {
      "pattern": "admin.kayanest.app",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "assets": {
    "directory": "./.output/public/",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "kayanest-hostel-images",
      "preview_bucket_name": "kayanest-preview-hostel-images"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "STORAGE",
      "id": "cf9244eada494b2f9452dcfff5662bf7",
      "preview_id": "59d1dbc3ea744cd1af2afdacc13c59d3"
    },
    {
      "binding": "DEVKV",
      "preview_id": "2acd94fa2acd45e8bc91d79b3fbfd152"
    },
    {
      "binding": "CACHE",
      "id": "cf9244eada494b2f9452dcfff5662bf7",
      "preview_id": "59d1dbc3ea744cd1af2afdacc13c59d3"
    }
  ],
  "vars": {},
  "env": {
    "preview": {
      "routes": [
        {
          "pattern": "preview.kayanest.app",
          "custom_domain": true
        },
        {
          "pattern": "admin.preview.kayanest.app",
          "custom_domain": true
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "kayanest-preview-hostel-images",
          "preview_bucket_name": "kayanest-preview-hostel-images"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "STORAGE",
          "id": "59d1dbc3ea744cd1af2afdacc13c59d3",
          "preview_id": "2acd94fa2acd45e8bc91d79b3fbfd152"
        },
        {
          "binding": "DEVKV",
          "preview_id": "2acd94fa2acd45e8bc91d79b3fbfd152"
        },
        {
          "binding": "CACHE",
          "id": "59d1dbc3ea744cd1af2afdacc13c59d3",
          "preview_id": "2acd94fa2acd45e8bc91d79b3fbfd152"
        }
      ],
      "vars": {},
      "triggers": {
        "crons": [
          "*/15 * * * *"
        ]
      }
    }
  }
}
